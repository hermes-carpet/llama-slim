# syntax=docker/dockerfile:1
#
# Dockerfile.binary — builds the SAME feature-optimized llama-server as the
# Docker image, but packages it as a SELF-CONTAINED flat bundle (for a Linux
# x86_64 host that has only the NVIDIA kernel driver). No web panel
# (ui-off). The build uses cmake-flags.sh so it cannot drift from the image.
#
# Output layout (the /app of the final "bundle" stage) — FLAT: everything in
# one directory (llama.cpp's backend plugin loader needs the backends next to
# the binary, not in a subdir).
#   llama-server-run       launcher (guard + LD_LIBRARY_PATH + doctor)
#   llama-server           the binary
#   *.so..                 llama/ggml backends + CUDA 13 runtime libs (flat)
#   preset.example.ini
#   update.sh              self-updater (downloads itself from GitHub Releases)
#   VERSION
#
# CI (auto-release-binary.yml) does the tar.zst + CPU gate against /app.

FROM nvidia/cuda:13.3.0-devel-ubuntu24.04 AS build

ARG GCC_VERSION=14

ENV DEBIAN_FRONTEND=noninteractive \
    CC=gcc-${GCC_VERSION} CXX=g++-${GCC_VERSION} CUDAHOSTCXX=g++-${GCC_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc-${GCC_VERSION} g++-${GCC_VERSION} \
        cmake ccache git ca-certificates python3 curl \
        libssl-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The build context (assembled by CI) = the llama.cpp source tree at top level
# PLUS the helper files (cmake-flags.sh, cmake-build.sh, llama-server-run,
# update.sh, preset.example.ini). Copy it all in.
WORKDIR /src
COPY . .

# sm_86 (RTX 30xx, e.g. the RTX 3090) + PTX so newer cards JIT-compile. Build
# via the shared bash script (Docker RUN runs under /bin/sh; the script avoids
# quoting pitfalls and is testable).
RUN bash cmake-build.sh ui-off "86-real"

# Assemble the flat, self-contained bundle in /bundle via the committed script
# (testable; avoids /bin/sh + set -e glob pitfalls in an inline RUN). The CUDA
# runtime libs are auto-discovered — no hardcoded path to drift on base bump.
RUN env BUNDLE_OUT=/bundle bash bundle.sh

# Final "bundle" stage: the self-contained /app the workflow tars. Plain
# debian:stable-slim runtime with exactly what the closure needs.
FROM debian:stable-slim AS bundle

ARG APP_VERSION=""
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 libssl3t64 libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# debian stable may name libssl3 / libcurl4 with t64 suffix; create the
# unsuffixed SONAME aliases the binary links, in case of a mismatch.
RUN set -e; \
    cd /lib/x86_64-linux-gnu \
    && for a in libssl.so.3 libcrypto.so.3 libcurl.so.4 \
                libgomp.so.1 libstdc++.so.6; do \
         if [ ! -e "$a" ]; then \
           cand=$(ls ${a%.*}*.so* 2>/dev/null | head -1 || true); \
           if [ -n "$cand" ]; then ln -s "$cand" "$a"; fi; \
         fi; \
       done \
    && echo "runtime lib aliases OK"

WORKDIR /app
# Helper files were staged into the build context by CI (see workflow), so they
# live in the build image at /src; bring them into /app.
COPY --from=build /src/llama-server-run /src/update.sh /src/preset.example.ini /app/
# The binary + every real .so blob, flat in /app. /bundle contains ONLY real
# blobs (no symlinks — bundle.sh copies real files and no longer creates the
# SONAME alias chain), so *.so* copies each blob exactly once with nothing to
# materialize. This includes the unversioned backends (libggml-cpu.so,
# libggml-cuda.so) and impl libs (libllama-server-impl.so) that have no .so.N.
# The versioned alias chain (libfoo.so.0 -> libfoo.so) is recreated as true
# symlinks in the next RUN. Mirrors the image (COPY --from /out/*.so* -> /app).
COPY --from=build /bundle/llama-server /app/llama-server
COPY --from=build /bundle/*.so* /app/
RUN set -e \
    && chmod +x /app/llama-server-run /app/llama-server /app/update.sh \
    && echo "${APP_VERSION}" > /app/VERSION \
    # Rebuild the SONAME alias chain as TRUE symlinks (zero bytes on disk):
    #   libfoo.so.0.1.2  ->  libfoo.so.0  ->  libfoo.so
    && cd /app \
    && for f in lib*.so.[0-9]*; do \
         name=$(basename "$f"); prefix=${name%%.so.*}; rest=${name##*.so.}; major=${rest%%.*}; \
         link1=${prefix}.so.${major}; \
         if [ "$name" != "$link1" ] && [ ! -e "$link1" ]; then ln -s "$name" "$link1"; fi; \
         if [ ! -e "${prefix}.so" ]; then ln -s "$link1" "${prefix}.so"; fi; \
       done \
    && echo "=== /app (the release payload, flat) ===" \
    && ls -lah /app \
    # ldd closure check: everything must resolve EXCEPT the host driver
    # (libcuda.so.1, never bundled). This is the real final runtime env.
    && for t in /app/llama-server /app/libllama-server-impl.so /app/libggml-cuda.so; do \
         if LD_LIBRARY_PATH=/app ldd "$t" 2>/dev/null | grep -F "not found" | grep -vF "libcuda.so.1"; then \
           echo "FATAL: unresolved deps on $t (payload not self-contained)"; LD_LIBRARY_PATH=/app ldd "$t" | grep -F "not found"; exit 1; \
         fi; \
       done \
    && echo "ldd closure: clean (only the host driver may be absent)" \
    && du -sh /app
