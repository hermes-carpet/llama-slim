# syntax=docker/dockerfile:1
#
# Dockerfile.binary — builds the SAME feature-optimized llama-server as the
# Docker image, but packages it as a SELF-CONTAINED flat bundle (for a Linux
# x86_64 host that has only the NVIDIA kernel driver). No web panel
# (ui-off). The build uses cmake-flags.sh so it cannot drift from the image.
#
# Output layout (the /app of the final "bundle" stage):
#   llama-server-run       launcher (guard + LD_LIBRARY_PATH)
#   llama-server           the binary
#   lib/*.so..             llama/ggml closure + CUDA 13 runtime libs
#   preset.example.ini
#   update.sh              self-updater (downloads itself from GitHub Releases)
#   VERSION
#
# CI (auto-release-binary.yml) does the tar.zst + CPU gate against /app.

FROM nvidia/cuda:13.3.0-devel-ubuntu24.04 AS build

ARG GCC_VERSION=14

ENV DEBIAN_FRONTEND=noninteractive \
    CC=gcc-${GCC_VERSION} CXX=g++-${GCC_VERSION} CUDAHOSTCXX=g++-${GCC_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc-${GCC_VERSION} g++-${GCC_VERSION} \
        cmake ccache git ca-certificates python3 curl \
        libssl-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# The build context (assembled by CI) = the llama.cpp source tree at top level
# PLUS the helper files (cmake-flags.sh, cmake-build.sh, llama-server-run,
# update.sh, preset.example.ini). Copy it all in.
WORKDIR /src
COPY . .

# sm_86 (RTX 30xx, e.g. the RTX 3090) + PTX so newer cards JIT-compile. Build
# via the shared bash script (Docker RUN runs under /bin/sh; the script avoids
# quoting pitfalls and is testable).
RUN bash cmake-build.sh ui-off "86-real"

# Assemble the flat, self-contained bundle in /bundle via the committed script
# (testable; avoids /bin/sh + set -e glob pitfalls in an inline RUN). The CUDA
# runtime libs are auto-discovered — no hardcoded path to drift on base bump.
RUN env BUNDLE_OUT=/bundle bash bundle.sh

# Final "bundle" stage: the self-contained /app the workflow tars. Plain
# debian:stable-slim runtime with exactly what the closure needs.
FROM debian:stable-slim AS bundle

ARG APP_VERSION=""
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 libssl3t64 libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# debian stable may name libssl3 / libcurl4 with t64 suffix; create the
# unsuffixed SONAME aliases the binary links, in case of a mismatch.
RUN set -e; \
    cd /lib/x86_64-linux-gnu \
    && for a in libssl.so.3 libcrypto.so.3 libcurl.so.4 \
                libgomp.so.1 libstdc++.so.6; do \
         if [ ! -e "$a" ]; then \
           cand=$(ls ${a%.*}*.so* 2>/dev/null | head -1 || true); \
           if [ -n "$cand" ]; then ln -s "$cand" "$a"; fi; \
         fi; \
       done \
    && echo "runtime lib aliases OK"

WORKDIR /app
COPY --from=build /bundle/llama-server /app/llama-server
COPY --from=build /bundle/lib /app/lib
COPY llama-server-run update.sh preset.example.ini /app/
RUN chmod +x /app/llama-server-run /app/llama-server /app/update.sh \
    && echo "${APP_VERSION}" > /app/VERSION \
    && echo "=== /app (the release payload) ===" \
    && ls -lah /app && du -sh /app
